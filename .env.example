# Copy to .env (never commit .env). All values are optional for local development.

# --- Server ---
PORT=8787
HOST=127.0.0.1
# Where waitlist registrations are stored (SQLite file). Put this on a persistent volume in production.
WAITLIST_DB_PATH=./data/waitlist.db
# Secret used to sign anti-spam form tokens. Set a long random string in production
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
WAITLIST_TOKEN_SECRET=
# Set to "true" only when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Extra origins allowed to POST to the API (comma separated). Same-origin is always allowed.
ALLOWED_ORIGINS=

# --- Build-time (used by `npm run build`) ---
# Official production origin, e.g. https://example.com. Enables canonical URL, og:url, sitemap.xml.
# Leave empty until the official domain is confirmed; the site then omits those tags.
SITE_URL=
# Official public contact address, if one exists. Leave empty until confirmed; nothing is invented.
CONTACT_EMAIL=
